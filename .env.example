# Configuración de OpenRouter API (OBLIGATORIO para traducir con IA)
OPENROUTER_API_KEY=tu_api_key_aqui
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_TIMEOUT=60

# Configuración del servidor Flask
FLASK_DEBUG=True
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Ruta opcional al ejecutable de Tesseract OCR en Windows
# Si Tesseract está en el PATH del sistema, puede dejarse vacío.
# Ejemplo: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# Límites del traductor de archivos PDF (MVP)
MAX_FILE_SIZE_MB=10
MAX_PDF_PAGES=20
TEMP_FILE_TTL_SECONDS=1800
